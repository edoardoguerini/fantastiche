# Copiato/generato da `just be env`; non usare questo placeholder come password.
MSSQL_SA_PASSWORD=CHANGE_ME_GENERATE_WITH_JUST_BE_ENV
MSSQL_PORT=14333
API_PORT=6060
Email__Provider=Local
Email__EnableExternalDelivery=false
Invitations__PublicBaseUrl=http://localhost:6061
