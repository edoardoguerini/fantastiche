# Reso a runtime da envsubst: solo ${API_UPSTREAM} viene sostituito.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 8080;
    server_name _;

    # IP reale del client: solo l'ingress di Container Apps raggiunge questo container,
    # quindi ci si fida dell'ULTIMA voce di X-Forwarded-For (quella aggiunta dall'ingress),
    # mai delle voci che il client potrebbe aver inviato da sé. Verso l'API si riscrive
    # l'header con la sola voce fidata.
    set_real_ip_from 0.0.0.0/0;
    real_ip_header X-Forwarded-For;
    real_ip_recursive off;
    root /app/dist/client;

    # Caricamento CSV del listone dal browser.
    client_max_body_size 20m;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    # API REST: stessa origin del FE, cookie SameSite=Lax intatti.
    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        # Upstream HTTPS (ingress interno di Container Apps): SNI obbligatorio per il routing.
        proxy_ssl_server_name on;
        proxy_ssl_protocols TLSv1.2 TLSv1.3;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 120s;
    }

    # SignalR: WebSocket con connessioni lunghe.
    location /hubs/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        # Upstream HTTPS (ingress interno di Container Apps): SNI obbligatorio per il routing.
        proxy_ssl_server_name on;
        proxy_ssl_protocols TLSv1.2 TLSv1.3;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # Il browser deve verificare il worker a ogni nuova versione.
    location = /sw.js {
        default_type application/javascript;
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }

    location = /manifest.webmanifest {
        default_type application/manifest+json;
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }

    # Asset con hash nel nome: cache lunga.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # File pubblici esistenti; le pagine vengono renderizzate da TanStack Start.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri @ssr;
    }

    location @ssr {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_buffering off;
        proxy_read_timeout 120s;
    }
}
